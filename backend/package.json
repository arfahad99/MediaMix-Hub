{
  "name": "mediamix-hub-backend",
  "version": "1.0.0",
  "description": "Backend API for MediaMix Hub - A modern media management application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --passWithNoTests"
    "azure:deploy": "zip -r deploy.zip . -x node_modules/\\* .git/\\* && az webapp deployment source config-zip --resource-group mediamix-hub-rg --name mediamix-hub-api --src deploy.zip"
  },
  "keywords": [
    "media",
    "upload",
    "api",
    "nodejs",
    "express",
    "azure"
  ],
  "author": "MediaMix Hub Team",
  "license": "MIT",
  "dependencies": {
    "@azure/storage-blob": "^12.17.0",
    "@azure/keyvault-secrets": "^4.7.0",
    "@azure/identity": "^3.4.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
  
}
